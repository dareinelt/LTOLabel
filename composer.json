{
    "name": "dareinelt/ltolabel",
    "description": "LTO tape barcode label generator for automated tape libraries (Dell EMC ML3 compatible)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "setasign/fpdf": "^1.8",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php -l src/**/*.php"
    },
    "config": {
        "sort-packages": true
    }
}
